{
  "model": "selftrain-fp16.onnx / selftrain-fp32.onnx (RF-DETR Medium @ 576, Manga109-s)",
  "inputs": [
    {
      "name": "input",
      "shape": [1, 3, 576, 576],
      "type": "tensor(float)",
      "layout": "CHW (channel-planar); preprocess: stretch-resize + ImageNet mean/std"
    }
  ],
  "outputs": [
    {
      "name": "dets",
      "shape": [1, 300, 4],
      "type": "tensor(float)",
      "format": "(cx, cy, w, h) normalized 0-1",
      "sample_min": 0.005906588397920132,
      "sample_max": 1.0579304695129395
    },
    {
      "name": "labels",
      "shape": [1, 300, 2],
      "type": "tensor(float)",
      "format": "raw logits (pre-sigmoid); col 0 = panel, col 1 = background; no NMS",
      "sample_min": -7.922564506530762,
      "sample_max": -2.7471444606781006
    }
  ]
}
